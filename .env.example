# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.

PORT=3000
MONGO_URI=mongodb://localhost:27017/erdalkazan

# Admin paneli şifresi. Düz metin ya da bcrypt hash'i olabilir (önerilen):
#   node -e "console.log(require('bcryptjs').hashSync('sifreniz', 12))"
# docker compose .env dosyalarında hash içindeki her $ işaretini $$ olarak yazın.
ADMIN_PASSWORD=
# Oturum imzalama anahtarı; uzun ve rastgele olmalı:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (görsel yükleme) - Cloudinary panelindeki API Keys sayfasından
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# production: oturum çerezi yalnızca HTTPS üzerinden gönderilir.
# Yerelde HTTP ile çalışırken development bırakın.
NODE_ENV=development

# Uygulama bir ters proxy (nginx, Caddy, Traefik...) arkasındaysa 1 yapın;
# böylece giriş deneme sınırı gerçek ziyaretçi IP'sine göre çalışır.
# Uygulamaya doğrudan erişiliyorsa boş bırakın.
TRUST_PROXY=
